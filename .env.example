# Database
DATABASE_URL=postgresql+asyncpg://argplant:argplant@localhost:5432/argplant

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenWeather API
OPENWEATHER_API_KEY=
OPENWEATHER_TIMEOUT=10

# NASA POWER
POWER_TIMEOUT=15

# Earthdata (SMAP)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# CDSE (Sentinel)
CDSE_USERNAME=
CDSE_PASSWORD=

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Storage
SATELLITE_STORAGE_PATH=data/satellite

# Ingestion (Pergamino, Buenos Aires)
INGESTION_COORDS_LAT=-33.89
INGESTION_COORDS_LON=-60.57
INGESTION_BBOX=-61,-34,-60,-33

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["*"]

# ------------------------------------------------------------------
# Feature flags — set to False for sources without valid credentials
# ------------------------------------------------------------------
ENABLE_OPENWEATHER=True
ENABLE_NASA_POWER=True
ENABLE_SMAP=True
ENABLE_SENTINEL=True
ENABLE_MAGYP=True

# ------------------------------------------------------------------
# LLM / AI Provider (for alert enrichment and synthesis)
# Supported: gemini | openai | anthropic | ollama
# ------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
